{
  "name": "AnyCockpit Bridge",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "incoming-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_xml",
          "accept": [
            "text/html",
            ".htm",
            ".html",
            "image/svg+xml",
            "text/xml",
            "application/xml",
            ".svg"
          ]
        }
      ]
    }
  }
}
